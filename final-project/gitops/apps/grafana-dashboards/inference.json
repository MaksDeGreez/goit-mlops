      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le, model_version) (rate(inference_request_duration_seconds_bucket{namespace=\"$namespace\"}[5m])))",
          "editorMode": "code",
          "legendFormat": "p50 version {{model_version}}",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, model_version) (rate(inference_request_duration_seconds_bucket{namespace=\"$namespace\"}[5m])))",
          "editorMode": "code",
          "legendFormat": "p95 version {{model_version}}",
          "range": true,
          "instant": false
        }
