# Settings of the local stack. Copy this file before starting it:
#
#   cp .env.example .env
#
# These values only exist on your own machine. Nothing here is a real secret
# and nothing here is used in the cluster: there the database password is
# generated by Terraform and handed to the pods as a Kubernetes Secret.

# Password of the local Postgres that MLflow stores its metadata in.
POSTGRES_PASSWORD=local-dev-password

# Written into every model version as the tag git_sha. The images have no git
# in them, so the value is passed in. CI passes the real commit.
GIT_SHA=local

# Who asked for a registry change. It ends up in the audit lines.
ACTOR=local
