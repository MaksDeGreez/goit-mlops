{
  "uid": "mlops-cost",
  "title": "MLOps - Cost",
  "description": "What this cluster costs, from OpenCost. The numbers are an estimate built from the public AWS price list, not from the real invoice.",
  "tags": [
    "mlops"
  ],
  "timezone": "browser",
  "editable": false,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "type": "stat",
      "title": "Cluster cost per hour",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(node_total_hourly_cost) + sum(pv_hourly_cost * on(persistentvolume) group_left() (kube_persistentvolume_capacity_bytes / 1024 / 1024 / 1024))",
          "editorMode": "code",
          "legendFormat": "__auto",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "decimals": 3
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "description": "Nodes plus disks, from the public AWS price list. The EKS control plane ($0.10 per hour) is not in it, because it is not a Kubernetes object.",
      "id": 1
