        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Both are client problems, so they are counted from the log events and not from the 4xx metric.",
      "id": 9
    },
    {
      "type": "timeseries",
      "title": "CPU used per pod",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"$namespace\", pod=~\"inference-.*\", container!=\"\"}[5m]))",
          "editorMode": "code",
          "legendFormat": "{{pod}}",
          "range": true,
          "instant": false
